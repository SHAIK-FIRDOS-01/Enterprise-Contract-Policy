# ==============================================================================
# ENTERPRISE CONTRACT & POLICY COPILOT — ENVIRONMENT CONFIGURATION SCHEMA
# Copy this file to .env and replace placeholders with your local environment values.
# NEVER commit raw secrets or production credentials to version control.
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=django-insecure-replace-with-a-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_DB=copilot_db
POSTGRES_USER=copilot_user
POSTGRES_PASSWORD=copilot_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Authentication & JWT Configuration
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# Groq LLM API Configuration
GROQ_API_KEY=gsk_dummy_groq_api_key_for_development
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model Configuration (HuggingFace / sentence-transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Document Storage & Ingestion
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=50

# Client Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
